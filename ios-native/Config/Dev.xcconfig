#include "Shared.xcconfig"

// Convex + WorkOS development deployment (dev:little-bat-382).
// Used by the "Dev" configuration and the "Dimo Dev" scheme, which build a
// separate "Dimo Dev" app that installs beside the production app.
// //$() escapes // so xcconfig does not treat the URL as a comment.
CONVEX_URL = https:/$()/little-bat-382.convex.cloud
WORKOS_CLIENT_ID = client_01KX83VG314Y92FTEJX28H23Z9

DIMO_BUNDLE_ID = app.dimo.ios.dev
DIMO_APP_GROUP = group.app.dimo.ios.dev
DIMO_DISPLAY_NAME = Dimo DEV
// Orange icon with a DEV band (Assets.xcassets/AppIcon-Dev).
DIMO_APP_ICON = AppIcon-Dev
